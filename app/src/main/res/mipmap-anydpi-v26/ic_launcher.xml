<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (artwork generated by tools/make_icon.py). The foreground is transparent
     and @color/ic_launcher_bg is the plate. A 6% inset keeps the centre card's corners
     and the dot row inside a circular mask (radius 375 of the 1080-unit design vs. the
     corners at 355); the side cards reach further but have faded out by then.
     No <monochrome> layer: the gradient card would flatten into a blob as a themed icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="6%" />
    </foreground>
</adaptive-icon>

<?xml version="1.0" encoding="utf-8"?>
<!-- Header icon button (replaced at runtime with a state-coloured version):
     cupertino style — hairline at rest, solid accent fill when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_ring" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
